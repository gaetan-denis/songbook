{% extends 'base.html.twig' %}

{% block title %}Songbook | Connexion{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                {# Affichage des messages flash ici #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show shadow rounded mb-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="card shadow-sm border-0">
                    <div class="card-header text-center bg-dark-blue text-light">
                        <h2 class="mb-0">Connexion</h2>
                    </div>
                    <div class="card-body bg-dark-blue text-light">
                        <form method="post">
                            {% if error %}
                                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}

                            {% if app.user %}
                                <div class="mb-3">
                                    Vous êtes connecté en tant que {{ app.user.userIdentifier }},
                                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                                </div>
                            {% endif %}

                            <div class="mb-3">
                                <label for="username" class="form-label">Email</label>
                                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Mot de passe</label>
                                <div class="input-group">
                                    <input type="password" name="_password" id="password" class="form-control password-field" autocomplete="current-password" required>
                                    <span class="input-group-text bg-white">
                                        <i class="fa fa-eye toggle-password" style="cursor: pointer;"></i>
                                    </span>
                                </div>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-check mb-3">
                                <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                                <label for="_remember_me" class="form-check-label">Se souvenir de moi</label>
                            </div>

                            <div class="d-grid">
                                <button class="btn btn-green" type="submit">Se connecter</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}


{% block javascripts %}
    {{ parent() }}
    <script>
        document.querySelectorAll('.toggle-password').forEach(function (icon) {
            icon.addEventListener('click', function () {
                const input = this.closest('.input-group').querySelector('.password-field');
                if (input.type === 'password') {
                    input.type = 'text';
                    this.classList.remove('fa-eye');
                    this.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    this.classList.remove('fa-eye-slash');
                    this.classList.add('fa-eye');
                }
            });
        });
    </script>
{% endblock %}