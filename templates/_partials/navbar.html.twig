{# templates/_partials/navbar.html.twig #}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
        <a class="navbar-brand text-sand" href="{{ path('app_home') }}">Songbook</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item d-flex align-items-center">
                    <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                </li>
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="d-none d-lg-inline">{{ app.user.username }}</span>
                            {% if app.user.avatarUrl %}
                                <img src="{{ app.user.avatarUrl }}" alt="avatar" class="rounded-circle ms-2" width="32" height="32" style="object-fit: cover;">
                            {% else %}
                                <i class="bi bi-person-circle text-white ms-2 fs-4"></i>
                            {% endif %}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="fas fa-user me-2"></i> Mon profil</a></li>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MODERATOR') %}
                                <li><a class="dropdown-item" href="{{ path('app_admin') }}"><i class="fas fa-tools me-2"></i> Administration</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-2"></i>Se déconnecter</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item d-flex align-items-center">
                        <a class="nav-link" href="{{ path('app_register') }}"><i class="fas fa-user-plus"></i> S'inscrire</a>
                    </li>
                    <li class="nav-item d-flex align-items-center">
                        <a class="nav-link" href="{{ path('app_login') }}"><i class="fas fa-sign-in-alt"></i> Se connecter</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
