{# templates/chordsheet/_delete_form.html.twig #}
<form method="post"
      action="{{ path('app_chordsheet_delete', {'id': chordsheet.id}) }}"
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette tablature ?');"
      style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ chordsheet.id) }}">
    <button class="btn btn-sm btn-outline-danger">
        <i class="fas fa-trash-alt me-1"></i> Supprimer
    </button>
</form>
