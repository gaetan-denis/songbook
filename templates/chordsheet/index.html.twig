{% extends 'base.html.twig' %}

{% block title %}Chordsheet index{% endblock %}

{% block body %}
    <h1>Chordsheet index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Content</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for chordsheet in chordsheets %}
            <tr>
                <td>{{ chordsheet.id }}</td>
                <td>{{ chordsheet.title }}</td>
                <td>{{ chordsheet.content }}</td>
                <td>{{ chordsheet.createdAt ? chordsheet.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_chordsheet_show', {'id': chordsheet.id}) }}">show</a>
                    <a href="{{ path('app_chordsheet_edit', {'id': chordsheet.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_chordsheet_new') }}">Create new</a>
{% endblock %}
