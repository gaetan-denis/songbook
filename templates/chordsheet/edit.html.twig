{% extends 'base.html.twig' %}

{% block title %}Modifier la Chordsheet{% endblock %}

{% block body %}
    <div class="container mt-5">

        <h1 class="h3 mb-4">Modifier la Chordsheet</h1>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                {{ include('chordsheet/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a href="{{ path('app_chordsheet_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>

            {{ include('chordsheet/_delete_form.html.twig') }}
        </div>

    </div>
{% endblock %}

