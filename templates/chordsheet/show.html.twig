{% extends 'base.html.twig' %}

{% block title %}Chordsheet{% endblock %}

{% block body %}
    <h1>Chordsheet</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ chordsheet.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ chordsheet.title }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ chordsheet.content }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ chordsheet.createdAt ? chordsheet.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_chordsheet_index') }}">back to list</a>

    <a href="{{ path('app_chordsheet_edit', {'id': chordsheet.id}) }}">edit</a>

    {{ include('chordsheet/_delete_form.html.twig') }}
{% endblock %}
