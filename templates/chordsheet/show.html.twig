{% extends 'base.html.twig' %}

{% block title %}Détails de la Chordsheet{% endblock %}

{% block body %}
    <div class="container mt-5">

        <h1 class="h3 mb-4">Détails de la Chordsheet</h1>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tbody>
                    <tr>
                        <th scope="row" class="text-nowrap">ID</th>
                        <td>{{ chordsheet.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-nowrap">Titre</th>
                        <td>{{ chordsheet.title }}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-nowrap">Contenu</th>
                        <td><pre class="mb-0">{{ chordsheet.content }}</pre></td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-nowrap">Créé le</th>
                        <td>{{ chordsheet.createdAt ? chordsheet.createdAt|date('d/m/Y H:i', 'Europe/Brussels') : '' }}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a href="{{ path('app_chordsheet_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>

            <div class="d-flex gap-2">
                <a href="{{ path('app_chordsheet_edit', {'id': chordsheet.id}) }}" class="btn btn-outline-dark">
                    <i class="fas fa-pen me-1"></i> Modifier
                </a>
                {{ include('chordsheet/_delete_form.html.twig') }}
            </div>
        </div>

    </div>
{% endblock %}
