{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Liste des utilisateurs</h1>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Nom d'utilisateur</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% set roleLabels = {
                            'ROLE_ADMIN': 'Administrateur',
                            'ROLE_MODERATOR': 'Modérateur'
                        } %}
                        {% set customRoles = user.roles|filter(role => role != 'ROLE_USER') %}
                        {% if customRoles is not empty %}
                            {{ customRoles|map(r => roleLabels[r] ?? r)|join(', ') }}
                        {% else %}
                            Utilisateur
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-sm btn-dark">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}