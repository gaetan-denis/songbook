{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Liste des utilisateurs</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <table class="table table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Nom d'utilisateur</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% set roleLabels = {
                'ROLE_ADMIN': 'Administrateur',
                'ROLE_MODERATOR': 'Modérateur',
                'ROLE_USER': 'Utilisateur'
            } %}

            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {{ roleLabels[user.role.name] ?? user.role.name }}
                    </td>
                    <td>
                        {% if user.isBanned %}
                            <span class="text-danger">Banni</span>
                        {% else %}
                            <span class="text-success">Actif</span>
                        {% endif %}
                    </td>
                    <td class="d-flex gap-1">
                        {# Modifier #}
                        <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-sm btn-dark" title="Modifier">
                            <i class="fa-solid fa-pen"></i>
                        </a>

                        {# Supprimer #}
                        <form method="post" action="{{ path('user_delete', {'id': user.id}) }}"
                              onsubmit="return confirm('⚠️ Es-tu sûr de vouloir supprimer {{ user.username }} ? Cette action est irréversible.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                            <button class="btn btn-sm btn-dark" title="Supprimer">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>

                        {# Bannir / Réactiver #}
                        <form method="post" action="{{ path('user_ban', {'id': user.id}) }}"
                              onsubmit="return confirm('{{ user.isBanned ? 'Réactiver' : 'Bannir' }} {{ user.username }} ?');">
                            <button class="btn btn-sm btn-dark" title="{{ user.isBanned ? 'Réactiver' : 'Bannir' }}">
                                <i class="fa-solid fa-ban"></i> {{ user.isBanned ? 'Réactiver' : 'Bannir' }}
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
