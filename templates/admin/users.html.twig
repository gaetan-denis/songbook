{% extends 'base.html.twig' %}


{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}

    {% set currentUser = app.user %}
    {% set roleLabels = {
        'ROLE_ADMIN': 'Administrateur',
        'ROLE_MODERATOR': 'Modérateur',
        'ROLE_USER': 'Utilisateur'
    } %}

    <div class="container mt-4 bg">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}
                    {{ label == 'success' ? 'custom-flash-success' : '' }}
                    alert-dismissible fade show"
                     role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
        <div class="d-flex justify-content-between align-items-center mt-5 mb-4 bg-dark-blue px-4 py-4">
            <div>
                <h1 class="h3 mb-0">
                    <i class="fa-solid fa-user me-2"></i>Gestion des utilisateurs
                </h1>
                <p class="mb-0 text-light">Administration et modération des utilisateurs</p>
            </div>
        </div>
        <!-- Modal de confirmation pour succession administrative -->
        {% if app.request.query.get('confirm_admin_transfer') %}
            {% set targetUserId = app.request.query.get('confirm_admin_transfer') %}
            {% set targetUser = null %}
            {% for user in users %}
                {% if user.id == targetUserId %}
                    {% set targetUser = user %}
                {% endif %}
            {% endfor %}

            {% if targetUser %}
                <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-danger">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">
                                    <i class="fa-solid fa-warning me-2"></i>
                                    Succession Administrative - Confirmation Requise
                                </h5>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-warning">
                                    <i class="fa-solid fa-exclamation-triangle me-2"></i>
                                    <strong>ATTENTION : Cette action est DÉFINITIVE et IMMÉDIATE</strong>
                                </div>

                                <p><strong>Vous êtes sur le point de :</strong></p>
                                <ul class="list-unstyled ms-3">
                                    <li><i class="fa-solid fa-arrow-up text-success me-2"></i>Promouvoir
                                        <strong>{{ targetUser.username }}</strong> au rang
                                        d'<strong>Administrateur</strong></li>
                                    <li><i class="fa-solid fa-arrow-down text-danger me-2"></i>Vous rétrograder au rang
                                        d'<strong>Utilisateur standard</strong></li>
                                </ul>

                                <div class="alert alert-danger mt-3">
                                    <h6><i class="fa-solid fa-ban me-2"></i>Conséquences :</h6>
                                    <ul class="mb-0 small">
                                        <li>Vous perdrez <strong>tous</strong> vos privilèges administrateur</li>
                                        <li>Vous ne pourrez plus gérer les utilisateurs, rôles ou paramètres</li>
                                        <li>Seul le nouvel administrateur pourra vous redonner des privilèges</li>
                                        <li><strong>Vous serez automatiquement déconnecté</strong> pour appliquer les
                                            changements
                                        </li>
                                        <li><strong>Cette action ne peut pas être annulée</strong></li>
                                    </ul>
                                </div>

                                <p class="text-center mt-3">
                                    <strong>Êtes-vous absolument certain(e) de vouloir procéder ?</strong>
                                </p>
                            </div>
                            <div class="modal-footer">
                                <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">
                                    <i class="fa-solid fa-times me-1"></i>Annuler
                                </a>

                                <form method="POST" action="{{ path('user_edit_role', {id: targetUser.id}) }}"
                                      class="d-inline">
                                    <input type="hidden" name="role" value="ROLE_ADMIN">
                                    <input type="hidden" name="admin_succession_confirmed" value="1">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('edit-role-' ~ targetUser.id) }}">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fa-solid fa-crown me-1"></i>Confirmer la Succession
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}

        <table class="table table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Nom d'utilisateur</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ roleLabels[user.role.name] ?? user.role.name }}</td>
                    <td>
                        {% if user.isBanned %}
                            <span class="text-danger">Banni</span>
                        {% else %}
                            <span class="text-success">Actif</span>
                        {% endif %}
                    </td>
                    <td class="d-flex gap-1">
                        <a href="{{ path('user_profile', {'id': user.id}) }}" class="btn btn-sm btn-light"
                           title="Profil">
                            <i class="fa-solid fa-user"></i>
                        </a>

                        {% if user != currentUser %}
                            {# Sélecteur de rôle actif #}
                            <form method="POST" action="{{ path('user_edit_role', {id: user.id}) }}" class="d-inline">
                                <select name="role"
                                        class="form-select form-select-sm d-inline w-auto align-middle role-selector"
                                        data-user-id="{{ user.id }}"
                                        data-user-name="{{ user.username }}"
                                        data-current-role="{{ user.role.name }}">
                                    <option value="ROLE_USER" {{ user.role.name == 'ROLE_USER' ? 'selected' : '' }}>
                                        Utilisateur
                                    </option>
                                    <option value="ROLE_MODERATOR" {{ user.role.name == 'ROLE_MODERATOR' ? 'selected' : '' }}>
                                        Modérateur
                                    </option>
                                    <option value="ROLE_ADMIN" {{ user.role.name == 'ROLE_ADMIN' ? 'selected' : '' }}>
                                        Admin
                                    </option>
                                </select>
                                <input type="hidden" name="_token" value="{{ csrf_token('edit-role-' ~ user.id) }}">
                            </form>

                            {# Supprimer #}
                            <form method="post"
                                  action="{{ path('user_delete', {'id': user.id}) }}"
                                  onsubmit="return confirm('⚠️ Supprimer {{ user.username }} ? Action irréversible.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                                <button class="btn btn-sm btn-dark" title="Supprimer">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>

                            {# Bannir / Réactiver #}
                            <form method="post"
                                  action="{{ path('user_ban', {'id': user.id}) }}"
                                  onsubmit="return confirm('{{ user.isBanned ? 'Réactiver' : 'Bannir' }} {{ user.username }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('ban-user-' ~ user.id) }}">
                                <button class="btn btn-sm btn-dark"
                                        title="{{ user.isBanned ? 'Réactiver' : 'Bannir' }}">
                                    <i class="fa-solid fa-ban"></i> {{ user.isBanned ? 'Réactiver' : 'Bannir' }}
                                </button>
                            </form>

                        {% else %}
                            {# Affichage désactivé pour utilisateur courant #}
                            <select class="form-select form-select-sm d-inline w-auto align-middle bg-secondary text-white border-0"
                                    disabled title="Impossible de modifier son propre rôle">
                                <option selected>{{ roleLabels[user.role.name] ?? user.role.name }}</option>
                            </select>

                            <button class="btn btn-sm btn-secondary" disabled title="Action désactivée">
                                <i class="fa-solid fa-trash"></i>
                            </button>

                            <button class="btn btn-sm btn-secondary" disabled title="Action désactivée">
                                <i class="fa-solid fa-ban"></i> Bannir
                            </button>
                        {% endif %}
                    </td>

                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const roleSelectors = document.querySelectorAll('.role-selector');

            roleSelectors.forEach(function (selector) {
                selector.addEventListener('change', function () {
                    const selectedRole = this.value;
                    const currentRole = this.dataset.currentRole;
                    const userName = this.dataset.userName;
                    const userId = this.dataset.userId;

                    // Si l'admin tente de promouvoir quelqu'un d'autre admin
                    if (selectedRole === 'ROLE_ADMIN' && currentRole !== 'ROLE_ADMIN') {
                        const isCurrentUserAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};

                        if (isCurrentUserAdmin) {
                            // Rediriger vers la page de confirmation
                            window.location.href = '{{ path('app_admin_users') }}?confirm_admin_transfer=' + userId;
                            return;
                        }
                    }

                    // Pour les autres changements, soumettre normalement
                    this.form.submit();
                });
            });
        });
    </script>
{% endblock %}