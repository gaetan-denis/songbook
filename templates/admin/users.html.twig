{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    {% set currentUser = app.user %}
    {% set roleLabels = {
        'ROLE_ADMIN': 'Administrateur',
        'ROLE_MODERATOR': 'Modérateur',
        'ROLE_USER': 'Utilisateur'
    } %}

    <div class="container mt-4">
        <h1>Liste des utilisateurs</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <table class="table table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Nom d'utilisateur</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ roleLabels[user.role.name] ?? user.role.name }}</td>
                    <td>
                        {% if user.isBanned %}
                            <span class="text-danger">Banni</span>
                        {% else %}
                            <span class="text-success">Actif</span>
                        {% endif %}
                    </td>
                    <td class="d-flex gap-1">
                        <a href="{{ path('user_profile', {'id': user.id}) }}" class="btn btn-sm btn-light" title="Profil">
                            <i class="fa-solid fa-user"></i>
                        </a>

                        {% if user != currentUser %}
                            {# Sélecteur de rôle actif #}
                            <form method="POST" action="{{ path('user_edit_role', {id: user.id}) }}" class="d-inline">
                                <select name="role"
                                        class="form-select form-select-sm d-inline w-auto align-middle"
                                        onchange="this.form.submit()">
                                    <option value="ROLE_USER" {{ user.role.name == 'ROLE_USER' ? 'selected' : '' }}>Utilisateur</option>
                                    <option value="ROLE_MODERATOR" {{ user.role.name == 'ROLE_MODERATOR' ? 'selected' : '' }}>Modérateur</option>
                                    <option value="ROLE_ADMIN" {{ user.role.name == 'ROLE_ADMIN' ? 'selected' : '' }}>Admin</option>
                                </select>
                                <input type="hidden" name="_token" value="{{ csrf_token('edit-role-' ~ user.id) }}">
                            </form>

                            {# Supprimer #}
                            <form method="post"
                                  action="{{ path('user_delete', {'id': user.id}) }}"
                                  onsubmit="return confirm('⚠️ Supprimer {{ user.username }} ? Action irréversible.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                                <button class="btn btn-sm btn-dark" title="Supprimer">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>

                            {# Bannir / Réactiver #}
                            <form method="post"
                                  action="{{ path('user_ban', {'id': user.id}) }}"
                                  onsubmit="return confirm('{{ user.isBanned ? 'Réactiver' : 'Bannir' }} {{ user.username }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('ban-user-' ~ user.id) }}">
                                <button class="btn btn-sm btn-dark" title="{{ user.isBanned ? 'Réactiver' : 'Bannir' }}">
                                    <i class="fa-solid fa-ban"></i> {{ user.isBanned ? 'Réactiver' : 'Bannir' }}
                                </button>
                            </form>

                        {% else %}
                            {# Affichage désactivé pour utilisateur courant #}
                            <select class="form-select form-select-sm d-inline w-auto align-middle bg-secondary text-white border-0" disabled title="Impossible de modifier son propre rôle">
                                <option selected>{{ roleLabels[user.role.name] ?? user.role.name }}</option>
                            </select>

                            <button class="btn btn-sm btn-secondary" disabled title="Action désactivée" >
                                <i class="fa-solid fa-trash"></i>
                            </button>

                            <button class="btn btn-sm btn-secondary" disabled title="Action désactivée">
                                <i class="fa-solid fa-ban"></i> Bannir
                            </button>
                        {% endif %}
                    </td>

                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
