{% extends 'base.html.twig' %}

{% block title %}Administration - Gestion des Partitions{% endblock %}

{% block body %}
    <div class="container">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show mt-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="d-flex justify-content-between align-items-center mt-5 mb-4 bg-dark-blue px-4 py-4">
            <div>
                <h1 class="h3 mb-0">
                    <i class="fas fa-music me-2"></i>Gestion des Partitions
                </h1>
                <p class="mb-0 text-light">Administration et modération des partitions</p>
            </div>
            <div>
                <a href="{{ path('app_admin') }}" class="btn btn-outline-light me-2">
                    <i class="fas fa-arrow-left me-2"></i> Retour
                </a>
                <span class="badge bg-light text-dark">
                    {{ partitions|length }} partition(s)
                </span>
            </div>
        </div>

        {% if partitions is not empty %}
            <div class="table-responsive mb-4">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Publié le</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for chordsheet in partitions %}
                        <tr>
                            <td>
                                <small class="text-muted">#{{ chordsheet.id }}</small>
                            </td>
                            <td>
                                <strong>{{ chordsheet.title }}</strong>
                            </td>
                            <td>
                                <i class="fas fa-user me-1"></i>
                                {{ chordsheet.user.username }}
                                {% if is_granted('ROLE_ADMIN', chordsheet.user) %}
                                    <span class="badge bg-danger ms-1">Admin</span>
                                {% elseif is_granted('ROLE_MODERATOR', chordsheet.user) %}
                                    <span class="badge bg-warning ms-1">Modérateur</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if chordsheet.publishedAt %}
                                    {{ chordsheet.publishedAt|date('d/m/Y H:i', 'Europe/Brussels') }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <!-- Bouton Voir la partition -->
                                <a href="{{ path('app_chordsheet_show', {'id': chordsheet.id}) }}"
                                   class="btn btn-sm btn-outline-dark"
                                   title="Voir la partition"
                                   target="_blank">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <!-- Bouton Profil utilisateur -->
                                <a href="{{ path('user_profile', {'id': chordsheet.user.id}) }}"
                                   class="btn btn-sm btn-outline-dark"
                                   title="Profil">
                                    <i class="fa-solid fa-user"></i>
                                </a>

                                <!-- Bouton Supprimer avec confirmation -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal{{ chordsheet.id }}"
                                        title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>

                                <!-- Modal de confirmation de suppression -->
                                <div class="modal fade" id="deleteModal{{ chordsheet.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ chordsheet.id }}" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="deleteModalLabel{{ chordsheet.id }}">
                                                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                                    Confirmer la suppression
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="alert alert-warning">
                                                    <strong>Attention !</strong> Cette action est irréversible.
                                                </div>

                                                <p>Vous êtes sur le point de supprimer définitivement la partition :</p>

                                                <div class="card bg-light">
                                                    <div class="card-body">
                                                        <h6 class="card-title">{{ chordsheet.title }}</h6>
                                                        <p class="card-text">
                                                            <small class="text-muted">
                                                                Par {{ chordsheet.user.username }} •
                                                                Publique
                                                                {% if chordsheet.publishedAt %}
                                                                    • Publiée le {{ chordsheet.publishedAt|date('d/m/Y à H:i') }}
                                                                {% endif %}
                                                            </small>
                                                        </p>
                                                    </div>
                                                </div>

                                                <p class="mt-3">Êtes-vous sûr de vouloir continuer ?</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <i class="fas fa-times me-1"></i>Annuler
                                                </button>
                                                <form method="post" action="{{ path('admin_partition_delete', {'id': chordsheet.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-partition-' ~ chordsheet.id) }}">
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="fas fa-trash me-1"></i>Supprimer définitivement
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Statistiques détaillées -->
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title text-primary">
                                <i class="fas fa-music"></i>
                            </h5>
                            <h3 class="card-text">{{ partitions|length }}</h3>
                            <p class="card-text">Total partitions</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title text-success">
                                <i class="fas fa-clock"></i>
                            </h5>
                            <h3 class="card-text">
                                {% set recentCount = 0 %}
                                {% set thirtyDaysAgo = date('-30 days') %}
                                {% for partition in partitions %}
                                    {% if partition.publishedAt and partition.publishedAt >= thirtyDaysAgo %}
                                        {% set recentCount = recentCount + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {{ recentCount }}
                            </h3>
                            <p class="card-text">Récentes (30j)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title text-info">
                                <i class="fas fa-users"></i>
                            </h5>
                            <h3 class="card-text">{{ uniqueUsersCount }}</h3>
                            <p class="card-text">Utilisateurs actifs</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liens utiles -->
            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="fas fa-external-link-alt me-2"></i>Liens rapides
                            </h5>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_chordsheet_library') }}" class="btn btn-outline-primary" target="_blank">
                                    <i class="fas fa-book me-1"></i>Voir la bibliothèque publique
                                </a>
                                <a href="{{ path('app_admin_users') }}" class="btn btn-outline-info">
                                    <i class="fas fa-users me-1"></i>Gérer les utilisateurs
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        {% else %}
            <div class="alert alert-info mb-4" role="alert">
                <h4 class="alert-heading">
                    <i class="fas fa-info-circle me-2"></i>Aucune partition
                </h4>
                <p>Il n'y a actuellement aucune partition dans la base de données.</p>
                <hr>
                <p class="mb-0">
                    Les utilisateurs peuvent créer des partitions depuis leur espace personnel.
                    <a href="{{ path('app_admin_users') }}" class="btn btn-sm btn-primary ms-2">
                        Gérer les utilisateurs
                    </a>
                </p>
            </div>
        {% endif %}

    </div>
{% endblock %}