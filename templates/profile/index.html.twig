{% extends 'base.html.twig' %}

{% block title %}Songbook | Mon Profil{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="container mt-4">
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="container mt-5 bg">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 bg">
                    <div class="card-header text-center bg-light">
                        <h2 class="mb-0">Mon Profil</h2>
                    </div>

                    <div class="card-body text-center">
                        {# AVATAR UTILISATEUR #}
                        {% if user.avatarUrl %}
                            <img src="{{ user.avatarUrl }}" alt="Avatar" class="rounded-circle mb-3" width="96" height="96" style="object-fit: cover;">
                        {% else %}
                            <i class="fas fa-user-circle fa-6x text-secondary mb-3"></i>
                        {% endif %}

                        <h5 class="card-title mb-2">Informations personnelles</h5>
                        <ul class="list-group list-group-flush mb-3 text-start">
                            <li class="list-group-item">
                                <strong>Nom d'utilisateur :</strong> {{ user.username }}
                            </li>
                            <li class="list-group-item">
                                <strong>Adresse email :</strong> {{ user.email }}
                            </li>
                        </ul>

                        <h5 class="card-title mb-2">Informations d'inscription</h5>
                        <ul class="list-group list-group-flush mb-3 text-start">
                            <li class="list-group-item">
                                <strong>Créé le :</strong> {{ user.createdAt|date('d/m/Y') }}
                            </li>
                            <li class="list-group-item">
                                <strong>Conditions acceptées le :</strong>
                                {% if user.termsAcceptedAt %}
                                    {{ user.termsAcceptedAt|date('d/m/Y à H:i') }}
                                {% else %}
                                    <span class="text-muted">Non spécifié</span>
                                {% endif %}
                            </li>
                        </ul>

                        <h5 class="card-title mb-2">Statut</h5>
                        <ul class="list-group list-group-flush text-start">
                            <li class="list-group-item">
                                <strong>Rôle :</strong>
                                {% if isAdmin %}
                                    <span class="badge bg-primary">
                                        <i class="fas fa-crown"></i> {{ role }}
                                    </span>
                                {% elseif 'ROLE_MODERATOR' in app.user.roles %}
                                    <span class="badge bg-primary">
                                        <i class="fas fa-shield-alt"></i> {{ role }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-primary">
                                        <i class="fas fa-user"></i> {{ role }}
                                    </span>
                                {% endif %}
                            </li>
                        </ul>
                    </div>

                    <div class="card-footer text-center bg-light">
                        <a href="{{ path('app_profile_edit') }}" class="btn btn-outline-primary">
                            ✏️ Modifier mon profil
                        </a>
                        <a href="{{ path('app_profile_export') }}" class="btn btn-outline-primary">
                            📄 Exporter mes données
                        </a>

                        {% if isAdmin %}
                            {# Bouton désactivé pour les administrateurs #}
                            <button class="btn btn-danger" disabled data-bs-toggle="tooltip"
                                    title="Les administrateurs ne peuvent pas supprimer leur compte. Transmettez d'abord vos privilèges.">
                                <i class="fas fa-lock"></i> Supprimer mon compte
                            </button>
                        {% else %}
                            {# Bouton normal pour les autres utilisateurs #}
                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                                Supprimer mon compte
                            </button>
                        {% endif %}
                    </div>
                </div>

                {% if isAdmin %}
                    {# Message d'information pour les administrateurs #}
                    <div class="alert alert-info mt-3" role="alert">
                        <h5 class="alert-heading">
                            <i class="fas fa-info-circle"></i> Information Administrateur
                        </h5>
                        <p class="mb-0">
                            En tant qu'administrateur, vous ne pouvez pas supprimer votre compte directement.
                            Cette mesure de sécurité garantit qu'au moins un administrateur reste toujours présent sur la plateforme.
                        </p>
                        <hr>
                        <p class="mb-0">
                            <strong>Pour supprimer votre compte :</strong> Transmettez d'abord vos privilèges d'administrateur à un autre utilisateur de confiance.
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% if not isAdmin %}
        {# Modal de confirmation uniquement si l'utilisateur n'est pas admin #}
        <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning" role="alert">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Attention !</strong> Cette action est irréversible.
                        </div>
                        <p>Êtes-vous absolument sûr de vouloir supprimer votre compte ?</p>
                        <p class="text-muted small">
                            Toutes vos données seront anonymisées et vous ne pourrez plus vous connecter.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <form method="post" action="{{ path('app_profile_delete') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Confirmer la suppression
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Initialiser les tooltips Bootstrap
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
{% endblock %}