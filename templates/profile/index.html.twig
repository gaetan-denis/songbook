{% extends 'base.html.twig' %}

{% block title %}Songbook | Mon Profil{% endblock %}

{% block body %}
    <h2>Mon Profil</h2>
    <ul>
        <li>Nom d'utilisateur : {{ user.username }}</li>
        <li>Adresse email : {{ user.email }}</li>
        <li>Date de création du compte : {{ user.createdAt|date('d/m/Y')}}</li>
        <li>Statut : {{ role }}</li>
    </ul>
{% endblock %}
