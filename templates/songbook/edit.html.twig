{% extends 'base.html.twig' %}

{% block title %}Edit Songbook{% endblock %}

{% block body %}
    <div class="container mt-4">

        <h1 class="mb-4">Modifier le songbook</h1>

        <div class="mb-3">
            {{ include('songbook/_form.html.twig', {'button_label': '🔄 Mettre à jour'}) }}
        </div>

        <div class="d-flex gap-2">
            <a href="{{ path('app_songbook_index') }}" class="btn btn-secondary">← Retour à la liste</a>

            <form method="post"
                  action="{{ path('app_songbook_delete', {'id': songbook.id}) }}"
                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce songbook ?');"
                  class="m-0">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ songbook.id) }}">
                <button class="btn btn-danger" type="submit">🗑 Supprimer</button>
            </form>
        </div>


    </div>
{% endblock %}
