{% extends 'base.html.twig' %}

{% block title %}Nouveau Songbook{% endblock %}

{% block body %}
    <div class="container">
        <div class="mb-4 text-center">
            <h1 class="h3">Créer un nouveau songbook</h1>
        </div>

        <div class="mx-auto col-md-6 col-lg-5">
            {{ form_start(form) }}
            {{ form_widget(form) }}

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark-blue w-50">
                    <i class="fas fa-save"></i> {{ button_label|default('Enregistrer')|raw }}
                </button>

                <a href="{{ path('app_songbook_index') }}" class="btn btn-secondary w-50">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
