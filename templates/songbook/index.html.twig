{% extends 'base.html.twig' %}

{% block title %}Mes Songbooks{% endblock %}

{% block body %}

    <div class="container">  {# Conteneur centré avec largeur max raisonnable #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show mt-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="d-flex justify-content-between align-items-center mt-5 mb-4 bg-dark-blue px-4 py-4">
            <h1 class="h3 mb-0">Mes Songbooks</h1>
            <a href="{{ path('app_songbook_new') }}" class="btn btn-primary bg-dark-blue border-light"><i class="fas fa-plus me-2"></i> Créer un nouveau songbook</a>
        </div>

        {% if songbooks is not empty %}
            <div class="table-responsive mb-4">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Créé le</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for songbook in songbooks %}
                        <tr>
                            <td>{{ songbook.id }}</td>
                            <td>{{ songbook.title }}</td>
                            <td>{{ songbook.description }}</td>
                            <td>{{ songbook.createdAt ? songbook.createdAt|date('d/m/Y H:i','Europe/Brussels') : '' }}</td>
                            <td>
                                <a href="{{ path('app_songbook_show', {'id': songbook.id}) }}" class="btn btn-sm btn-outline-dark-blue"><i class="fas fa-eye me-1"></i> Voir</a>
                                <a href="{{ path('app_songbook_edit', {'id': songbook.id}) }}" class="btn btn-sm btn-outline-dark"><i class="fas fa-pen me-1"></i> Modifier</a>

                                {# Bouton pour ouvrir la modale de suppression #}
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ songbook.id }}">
                                    <i class="fas fa-trash me-1"></i> Supprimer
                                </button>

                                {# Modale de confirmation #}
                                <div class="modal fade" id="deleteModal{{ songbook.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ songbook.id }}" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title" id="deleteModalLabel{{ songbook.id }}">Confirmer la suppression</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p><i class="fas fa-triangle-exclamation text-warning me-2"></i> Attention : cette suppression est définitive.</p>
                                                <p>Voulez-vous vraiment supprimer le songbook <strong>{{ songbook.title }}</strong> ?</p>
                                                <p>La suppression du recueil entraînera aussi la suppression de <strong>toutes les partitions</strong> qu'il contient.</p>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                <form method="post" action="{{ path('app_songbook_delete', {'id': songbook.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ songbook.id) }}">
                                                    <button class="btn btn-danger">🗑 Supprimer</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-warning mb-4" role="alert">
                Aucun songbook trouvé.
            </div>
        {% endif %}

    </div>
{% endblock %}
