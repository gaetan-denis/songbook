{% extends 'base.html.twig' %}

{% block title %}Mes Songbooks{% endblock %}

{% block body %}
    <div class="container">  {# Conteneur centré avec largeur max raisonnable #}

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Mes Songbooks</h1>
            <a href="{{ path('app_songbook_new') }}" class="btn btn-primary">➕ Créer un nouveau songbook</a>
        </div>

        {% if songbooks is not empty %}
            <div class="table-responsive mb-4">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Créé le</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for songbook in songbooks %}
                        <tr>
                            <td>{{ songbook.id }}</td>
                            <td>{{ songbook.title }}</td>
                            <td>{{ songbook.description }}</td>
                            <td>{{ songbook.createdAt ? songbook.createdAt|date('d/m/Y H:i','Europe/Brussels') : '' }}</td>
                            <td>
                                <a href="{{ path('app_songbook_show', {'id': songbook.id}) }}" class="btn btn-sm btn-outline-info">👁 Voir</a>
                                <a href="{{ path('app_songbook_edit', {'id': songbook.id}) }}" class="btn btn-sm btn-outline-secondary">✏️ Modifier</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-warning mb-4" role="alert">
                Aucun songbook trouvé.
            </div>
        {% endif %}

    </div>
{% endblock %}
